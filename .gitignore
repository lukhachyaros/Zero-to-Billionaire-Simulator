# ==========================================
# Unity Standard .gitignore
# ==========================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta-files of deleted files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated meta files
*.pidb
*.pdb
*.mdb

# Unity Asset Store cache
AssetStoreTools*

# Crash reports
sysinfo.txt

# ==========================================
# Visual Studio / Rider / VS Code
# ==========================================
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# ==========================================
# Apple iOS & Xcode
# ==========================================
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
/*.gcno
**/[Xx]code/build/
**/[Xx]code/DerivedData/
*.xcuserstate
project.xcworkspace
xcuserdata/
Pods/
Podfile.lock
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ==========================================
# Node / Tooling & Artifacts
# ==========================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.*.local
*.log
*.sqlite
*.sqlite-wal
*.sqlite-shm
server/data/
**/__pycache__/
